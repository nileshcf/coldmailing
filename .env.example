# SMTP credentials. For Gmail, use an app password instead of your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@example.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=your.email@example.com
SENDER_NAME=Your Name

# Campaign defaults.
CONTACTS_CSV=examples/contacts.csv
SUBJECT_TEMPLATE=Intro for {company}
BODY_TEMPLATE=templates/default.txt
ATTACHMENT_PATH=
PROGRESS_FILE=progress/campaign_progress.txt
BATCH_LIMIT=25
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=90

# Values available to the template.
SENDER_TITLE=Your Role
SENDER_PHONE=
SENDER_LINKEDIN=https://www.linkedin.com/in/your-profile
SENDER_GITHUB=https://github.com/your-username
SENDER_PORTFOLIO=
ROLE=your target role
VALUE_PROPOSITION=one short sentence about the value you bring
ASK=Would you be open to a short conversation?
